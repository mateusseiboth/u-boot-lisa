/*
 * HakiOS's U-Boot on the Xiaomi 11 Lite 5G NE (lisa): board/qualcomm/qcom-phone.env with a boot menu for
 * postmarketOS and HakiOS
 */
bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

fastboot=fastboot -l $fastboot_addr_r usb 0
/* the fastboot screen: the menu clears the display on its way out and fastboot itself draws nothing */
fastboot_screen=cls; bmp display fastboot m m; run fastboot

/* UFS: postmarketOS and the HakiOS loader read their partitions through U-Boot's block devices */
preboot=scsi scan

/*
 * Multiboot: the menu at every start, postmarketOS after 5 seconds unless the volume keys pick another entry
 * (volume up and down move, power selects). An entry that returns leaves the menu on the screen.
 */
bootcmd=setenv bootmenu_default 1; bootmenu 5; run menucmd

/*
 * postmarketOS: its image sits inside userdata with a partition table of its own, so blkmap maps userdata as a disk
 * and sysboot reads the extlinux.conf that boot-deploy writes to the image's boot partition (1).
 * The device tree Linux gets is the one ABL handed over (prevbl_fdt_addr), with ABL's fixups and the Gunyah hypervisor
 * overlay applied: with fdt_addr_r unset, sysboot skips the extlinux fdt line and passes fdt_addr.
 * part start gives hex; blkmap's linear source block is read as decimal.
 */
pmos_boot=part start scsi 0 userdata pmos_start && part size scsi 0 userdata pmos_size && \
	setexpr pmos_start_dec fmt %d 0x${pmos_start} && \
	run pmos_blkmap && blkmap get pmos dev pmos_dev && \
	setenv fdt_addr ${prevbl_fdt_addr} && setenv fdt_addr_r && \
	sysboot blkmap ${pmos_dev}:1 any ${pxefile_addr_r} /extlinux/extlinux.conf; \
	echo "postmarketOS: could not boot"; pause
pmos_blkmap=if blkmap get pmos dev pmos_dev; then blkmap destroy pmos; fi; \
	blkmap create pmos && blkmap map pmos 0 ${pmos_size} linear scsi 0 ${pmos_start_dec}

/*
 * The HakiOS loader and its payload from memory: from the boot image's ramdisk when ABL brought one, else from the
 * host over fastboot (hakios_fastboot). Nothing is written to the phone's storage on the way.
 * When the loader comes back (it only does on "fastboot oem bootos:..."), osel_check starts what the host asked for.
 */
hakios_memory=if hakios load; then hakios boot; run osel_check; fi; run hakios_fastboot
hakios_fastboot=echo; echo "HakiOS: waiting for the host:"; \
	echo "  fastboot stage x.hkub"; \
	echo "  fastboot oem run:hakios load fastboot"; \
	echo "  fastboot continue"; \
	setenv bootretry -1; run fastboot; hakios boot; run osel_check; pause; run menucmd

/*
 * The OS chosen from the host, with no button pressed (darwin-lisa/tools/bootos.sh): the host sends
 * "fastboot oem bootos:pmos" (or ums, uboot, menu) to the loader; the loader answers, stops its USB function and its
 * watchdog and exits back to here, after leaving a one-shot request in the last page of the payload window
 * (hakios-payload@f0000000 in the device tree: nothing in U-Boot allocates there). No reset is involved, so the
 * request never has to survive one: every reset on lisa is a PMIC hard reset (ABL's log: "Reset Type: Hard Reset").
 * The request is "OSEL" (0x4c45534f), a code, and the code inverted; it is cleared before it is acted on, so a target
 * that fails falls back to the loader's own fallback and never loops. Without a request nothing changes.
 *   1 postmarketOS   2 USB disk (UFS LUN 0, for the PC)   3 U-Boot's fastboot   4 this menu
 */
osel_addr=0xf3fff000
osel_check=setexpr osel_a4 ${osel_addr} + 4; setexpr osel_a8 ${osel_addr} + 8; \
	setexpr.l osel_m *${osel_addr}; setexpr.l osel_c *${osel_a4}; setexpr.l osel_n *${osel_a8}; \
	setexpr osel_x ${osel_c} ^ ${osel_n}; mw.l ${osel_addr} 0 3; \
	if test "${osel_m}" = "4c45534f" && test "${osel_x}" = "ffffffff"; then \
		echo "HakiOS loader: the host asked for target ${osel_c}"; run osel_${osel_c}; fi
osel_1=run pmos_boot
osel_2=run ums_disk
osel_3=run fastboot_screen
osel_4=run menucmd

/*
 * The phone's UFS logical unit 0 (sda: userdata, super, ...) as a USB disk for the PC, which then reads and writes it
 * with its own tools while no OS runs on the phone. It ends when the PC ejects the disk (eject /dev/sdX), when the
 * cable is pulled or when a key is pressed; then the phone restarts into the menu.
 */
ums_disk=echo "USB disk: UFS LUN 0. Eject it on the PC (or press a key) to restart."; \
	setenv bootretry -1; ums 0 scsi 0; reset

serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	setenv bootretry -1; \
	echo Enabled U-Boot console serial gadget

menucmd=setenv bootcmd run menucmd; bootmenu -1

bootmenu_0=postmarketOS=run pmos_boot
bootmenu_1=HakiOS=run hakios_memory
bootmenu_2=HakiOS over fastboot=run hakios_fastboot
bootmenu_3=Enable serial console gadget=run serial_gadget
bootmenu_4=Enable fastboot mode=run fastboot_screen
bootmenu_5=USB disk for the PC (UFS LUN 0)=run ums_disk
bootmenu_6=What is in memory=hakios info; pause
bootmenu_7=Drop to shell=setenv bootretry -1
bootmenu_8=Reset device=reset
bootmenu_9=Board info=bdinfo; meminfo; pause

/* hold volume down while U-Boot starts: the menu without the 5 second countdown */
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
